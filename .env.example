# --- Base de données (Supabase > Project Settings > Database > Connection string > "Transaction pooler") ---
DATABASE_URL=postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# --- Stockage des photos (Supabase > Project Settings > API) ---
# Facultatif : sans ces deux lignes, l'admin accepte seulement un lien d'image.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Page admin ---
ADMIN_PASSWORD=change-moi
# Chaîne aléatoire longue (ex. : openssl rand -hex 32)
ADMIN_SESSION_SECRET=

# --- Boutique ---
NEXT_PUBLIC_SHOP_NAME=Boutique 514
# Numéro WhatsApp affiché aux clients (format international, sans +)
NEXT_PUBLIC_WHATSAPP=

# --- Paiements en ligne (désactivés tant que les comptes ne sont pas ouverts) ---
# CIB / Edahabia via Chargily Pay : il suffit de mettre la clé secrète
# (test_sk_… pour tester sans argent réel, live_sk_… une fois le compte vérifié).
CHARGILY_SECRET_KEY=
# Mettre false pour masquer temporairement l'option sans retirer la clé.
ENABLE_CHARGILY=true
# Carte internationale pour « offrir depuis l'étranger » via Stripe
ENABLE_STRIPE_GIFT=false
STRIPE_SECRET_KEY=
